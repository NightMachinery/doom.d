# night-mail identity. Copy to ~/.config/night-mail/identity.env, chmod 600,
# and fill in. It is private and must never be committed.
#
# Sourced by bash (email/bin/night-mail-render): plain KEY=value lines, quote
# values that contain spaces.

# Short name for the account: the Maildir subfolder, the mbsync channel and
# the msmtp account are all called this.
NIGHT_MAIL_ACCOUNT=work
NIGHT_MAIL_NAME="Your Name"
NIGHT_MAIL_ADDRESS=you@example.org
# Semicolon-separated other addresses that deliver to the same mailbox.
NIGHT_MAIL_ALIASES=you@alias.example.org
NIGHT_MAIL_USER=you
NIGHT_MAIL_HOST=mail.example.org

# Optional; these are the defaults.
# NIGHT_MAIL_IMAP_PORT=993
# NIGHT_MAIL_SMTP_PORT=465
# NIGHT_MAIL_ROOT="$HOME/Mail"
