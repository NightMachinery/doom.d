#!/bin/bash
# night-mail-render [--plist DEST]: write the mail tools' configs from the
# templates in ../templates and the private identity file.
#
# The identity (address, username, host, name) is private and lives outside
# this public repository, in $NIGHT_MAIL_IDENTITY (default
# ~/.config/night-mail/identity.env; see ../identity.env.example). The
# templates hold everything else.
#
# Outputs go where each tool looks by default, so plain `mbsync', `msmtp' and
# `notmuch' work from a shell with no flags or environment:
#
#   ~/.config/isyncrc                 mbsync
#   ~/.config/msmtp/config            msmtp
#   ~/.config/notmuch/default/config  notmuch
#   DEST                              the LaunchAgent, with --plist
#
# Each output is written atomically, mode 600. An existing file that does not
# carry the "Generated by night-mail-render" marker is someone else's, and is
# never overwritten.
#
# See docs/email.md.

# No `set -e': bash 3.2 exits on a failing `command grep' even inside an `if'
# condition. Each step that can fail says so explicitly instead.
set -uo pipefail

email_dir="$(cd "$(command dirname "${BASH_SOURCE[0]}")/.." && pwd -P)"
templates="$email_dir/templates"
identity="${NIGHT_MAIL_IDENTITY:-$HOME/.config/night-mail/identity.env}"
config_home="${XDG_CONFIG_HOME:-$HOME/.config}"
marker='Generated by night-mail-render'

die() { printf 'night-mail-render: %s\n' "$*" >&2 ; exit 1 ; }

plist_dest=''
case "${1:-}" in
    --plist) plist_dest="${2:?--plist needs a destination}" ;;
    '') ;;
    *) printf 'usage: %s [--plist DEST]\n' "${0##*/}" >&2 ; exit 64 ;;
esac

[ -r "$identity" ] || die "no identity file at $identity; see $email_dir/identity.env.example"
mode="$(command stat -f %Lp "$identity")" || die "cannot stat $identity"
case "$mode" in
    600|400) ;;
    *) die "$identity is mode $mode; it is private, so chmod 600 it" ;;
esac
# shellcheck source=/dev/null
. "$identity" || die "could not read $identity"

: "${NIGHT_MAIL_ALIASES:=}"
: "${NIGHT_MAIL_IMAP_PORT:=993}"
: "${NIGHT_MAIL_SMTP_PORT:=465}"
: "${NIGHT_MAIL_ROOT:=$HOME/Mail}"
NIGHT_MAIL_ROOT="${NIGHT_MAIL_ROOT%/}"
NIGHT_MAIL_EMAIL_DIR="$email_dir"
NIGHT_MAIL_STATE_DIR="$HOME/.local/state/night-mail"
NIGHT_MAIL_LOG_FILE="$HOME/logs/night-mail-sync.log"

keys='ACCOUNT NAME ADDRESS ALIASES USER HOST IMAP_PORT SMTP_PORT ROOT EMAIL_DIR STATE_DIR LOG_FILE'
for k in $keys ; do
    v="NIGHT_MAIL_$k"
    [ "$k" = ALIASES ] || [ -n "${!v:-}" ] || die "$v is not set in $identity"
    export "$v"
done

# render TEMPLATE DEST
render() {
    local tmpl="$templates/$1" dest="$2" s tmp
    [ -r "$tmpl" ] || die "missing template $tmpl"
    if [ -e "$dest" ] && ! command grep -q -- "$marker" "$dest" ; then
        die "$dest exists and was not generated by night-mail-render; move it aside first"
    fi
    command grep -q -- "$marker" "$tmpl" || die "$tmpl lacks the marker line"
    # perl, not ${s//pat/rep}: bash 3.2 keeps quotes around the replacement
    # literally, and bash 5.2 expands `&' in it without them. Values arrive
    # through the environment, so no quoting of them is involved at all.
    # An unknown placeholder is left alone, for the check below to report.
    s="$(command perl -pe 's/\@(NIGHT_MAIL_[A-Z_]+)\@/exists $ENV{$1} ? $ENV{$1} : $&/ge' "$tmpl")" ||
        die "could not fill in $tmpl"
    if command grep -q -E '@NIGHT_MAIL_[A-Z_]+@' <<<"$s" ; then
        die "$tmpl uses a placeholder with no value: $(command grep -o -E '@NIGHT_MAIL_[A-Z_]+@' <<<"$s" | command head -1)"
    fi
    command mkdir -p "$(command dirname "$dest")" || die "cannot create the folder for $dest"
    tmp="$dest.tmp.$$"
    ( umask 077 ; printf '%s\n' "$s" >| "$tmp" ) || die "cannot write $tmp"
    command mv -f -- "$tmp" "$dest" || die "cannot move $tmp into place"
    printf 'rendered %s\n' "$dest"
}

render isyncrc.tmpl        "$config_home/isyncrc"
render msmtp-config.tmpl   "$config_home/msmtp/config"
render notmuch-config.tmpl "$config_home/notmuch/default/config"
if [ -n "$plist_dest" ] ; then
    render com.user.night-mail-sync.plist.tmpl "$plist_dest"
fi

command mkdir -p "$NIGHT_MAIL_STATE_DIR" "$(command dirname "$NIGHT_MAIL_LOG_FILE")" ||
    die "cannot create $NIGHT_MAIL_STATE_DIR"
