#!/usr/bin/env python3
"""Best-effort desktop alerts for this indexing run's new inbox messages."""
import argparse
from collections import defaultdict
from contextlib import contextmanager
from email import policy
from email.header import decode_header, make_header
from email.parser import BytesParser
import fcntl
import hashlib
from html.parser import HTMLParser
import json
import os
from pathlib import Path
import re
import signal
import subprocess
import sys
import tempfile
import time

DEFAULTS = {"enabled": True, "show_details": True, "sound": None,
            "bypass_dnd": False, "max_individual": 3,
            "preview_chars": 300, "preview_lines": 3}
DEFAULT_CONFIG = {"defaults": DEFAULTS, "groups": [{"name": "Other mail"}]}


class NotificationTimeout(Exception):
    """A bad regex or slow subprocess must not hold the sync lock forever."""


def time_limit(_signum, _frame):
    raise NotificationTimeout("notification processing exceeded 45 seconds")


def config_path():
    return Path(os.environ.get("NIGHT_MAIL_NOTIFY_CONFIG",
                str(Path(os.environ.get("XDG_CONFIG_HOME", str(Path.home() / ".config")))
                    / "night-mail/notifications.json")))


def validate_settings(settings, context):
    if not isinstance(settings, dict) or settings.keys() - DEFAULTS.keys():
        raise ValueError(f"{context}: expected only notification setting keys")
    for key, value in settings.items():
        if key in ("enabled", "show_details", "bypass_dnd") and type(value) is not bool:
            raise ValueError(f"{context}.{key}: expected a boolean")
        if key == "max_individual" and (type(value) is not int or not 1 <= value <= 20):
            raise ValueError(f"{context}.max_individual: expected an integer from 1 to 20")
        if key == "preview_chars" and (type(value) is not int or not 0 <= value <= 1000):
            raise ValueError(f"{context}.preview_chars: expected an integer from 0 to 1000")
        if key == "preview_lines" and (type(value) is not int or not 1 <= value <= 10):
            raise ValueError(f"{context}.preview_lines: expected an integer from 1 to 10")
        if key == "sound" and value is not None and (not isinstance(value, str) or not value.strip()):
            raise ValueError(f"{context}.sound: expected a sound name or null")


def load_config(filename):
    try:
        raw = json.loads(filename.read_text())
    except FileNotFoundError:
        raw = DEFAULT_CONFIG
    except json.JSONDecodeError as error:
        raise ValueError(f"invalid JSON at line {error.lineno}, column {error.colno}") from None
    if not isinstance(raw, dict) or raw.keys() - {"defaults", "groups"}:
        raise ValueError("expected an object containing defaults and groups")
    defaults = raw.get("defaults", {})
    validate_settings(defaults, "defaults")
    defaults = dict(DEFAULTS, **defaults)
    groups = raw.get("groups")
    if not isinstance(groups, list) or not groups:
        raise ValueError("groups must be a nonempty list ending in a catch-all")
    result, names = [], set()
    for index, group in enumerate(groups):
        context = f"groups[{index}]"
        if not isinstance(group, dict) or group.keys() - (DEFAULTS.keys() | {"name", "match"}):
            raise ValueError(f"{context}: unknown group keys")
        name = group.get("name")
        if not isinstance(name, str) or not name.strip() or name in names:
            raise ValueError(f"{context}: name must be nonempty and unique")
        names.add(name)
        match = group.get("match")
        if index == len(groups) - 1:
            if "match" in group:
                raise ValueError("the final group must omit match (unconditional catch-all)")
            match = {}
        elif not isinstance(match, dict) or not match or match.keys() - {"from", "subject"}:
            raise ValueError(f"{context}.match: specify from and/or subject regexes")
        compiled = {}
        for field, pattern in match.items():
            if not isinstance(pattern, str) or not pattern:
                raise ValueError(f"{context}.match.{field}: expected a nonempty regex")
            try:
                compiled[field] = re.compile(pattern, re.IGNORECASE)
            except re.error:
                raise ValueError(f"{context}.match.{field}: invalid regex") from None
        settings = {key: value for key, value in group.items() if key in DEFAULTS}
        validate_settings(settings, context)
        result.append({"name": name, "match": compiled, **dict(defaults, **settings)})
    return result


def run(args, timeout=20):
    # Command errors must not echo headers, queries, or notification argv to logs.
    try:
        result = subprocess.run([str(a) for a in args], stdin=subprocess.DEVNULL,
                                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                                timeout=timeout, check=False)
    except subprocess.TimeoutExpired:
        raise RuntimeError(f"{Path(args[0]).name} timed out") from None
    if result.returncode:
        raise RuntimeError(f"{Path(args[0]).name} exited with status {result.returncode}")
    return result.stdout.decode("utf-8", errors="replace")


def decode(value):
    try:
        return str(make_header(decode_header(value or "")))
    except (ValueError, LookupError, UnicodeError):
        return value or ""


def clean(text, limit=200):
    # One bounded line, including removal of terminal controls and bidi controls.
    text = re.sub(r"[\x00-\x1f\x7f-\x9f\u202a-\u202e\u2066-\u2069]", " ", text)
    text = " ".join(text.split())
    return text if len(text) <= limit else text[:limit - 1] + "…"


class HTMLPreview(HTMLParser):
    """Plain local text only: no network, scripts, styles, or quoted history."""
    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.parts, self.hidden = [], 0

    def handle_starttag(self, tag, attrs):
        if tag in ("script", "style", "head", "blockquote"):
            self.hidden += 1
        if not self.hidden and tag in ("p", "div", "br", "li", "tr", "h1", "h2", "h3"):
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if tag in ("script", "style", "head", "blockquote"):
            self.hidden = max(0, self.hidden - 1)
        if not self.hidden and tag in ("p", "div", "li", "tr"):
            self.parts.append("\n")

    def handle_data(self, data):
        if not self.hidden:
            self.parts.append(data)


def body_preview(message, settings):
    chars, lines = settings["preview_chars"], settings["preview_lines"]
    if not chars:
        return ""
    for filename in message.get("filenames", []):
        try:
            # Only selected arrivals reach here. MIME parsing is local and
            # bounded even if the original mail contains enormous attachments.
            with Path(filename).open("rb") as stream:
                raw = stream.read(256 * 1024)
            mail = BytesParser(policy=policy.default).parsebytes(raw)
            part = mail.get_body(preferencelist=("plain", "html"))
            if part is None:
                continue
            payload = part.get_payload(decode=True) or b""
            try:
                text = payload.decode(part.get_content_charset() or "utf-8", errors="replace")
            except LookupError:
                text = payload.decode("utf-8", errors="replace")
            if part.get_content_type() == "text/html":
                parser = HTMLPreview()
                parser.feed(text)
                text = "".join(parser.parts)
            meaningful = []
            for line in text.splitlines():
                if line.strip() == "--":
                    break
                if line.lstrip().startswith(">") or re.match(r"^On .+wrote:\s*$", line, re.I):
                    continue
                value = clean(line, 1000)
                if value:
                    meaningful.append(value)
            preview = "\n".join(meaningful[:lines])
            if len(preview) > chars or len(meaningful) > lines:
                preview = preview[:chars - 1].rstrip() + "…"
            return preview
        except (OSError, ValueError, TypeError, UnicodeError):
            # A vanished or malformed message still gets its header alert.
            continue
    return ""


def message_token(message_id):
    return hashlib.sha256(message_id.encode("utf-8")).hexdigest()


def alert_id(tokens):
    return "night-mail-" + message_token("\n".join(sorted(tokens)))


@contextmanager
def alert_state():
    """Serialize posting and dismissal; persist hashes only, never mail headers."""
    directory = Path.home() / ".local/state/night-mail"
    directory.mkdir(parents=True, exist_ok=True)
    filename = directory / "notification-alerts.json"
    with (directory / "notification-alerts.lock").open("a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            state = json.loads(filename.read_text())
        except FileNotFoundError:
            state = {}
        except json.JSONDecodeError:
            raise ValueError("invalid notification-alerts.json; remove it to reset dismissal tracking") from None
        if (not isinstance(state, dict) or any(
                not re.fullmatch(r"night-mail-[0-9a-f]{64}", key)
                or not isinstance(entry, dict)
                or not isinstance(entry.get("created"), (int, float))
                or not isinstance(entry.get("messages"), list)
                or not entry["messages"]
                or any(not isinstance(token, str) or not re.fullmatch(r"[0-9a-f]{64}", token)
                       for token in entry["messages"])
                for key, entry in state.items())):
            raise ValueError("invalid notification-alerts.json; remove it to reset dismissal tracking")
        cutoff = time.time() - 30 * 86400
        state = {key: entry for key, entry in state.items() if entry["created"] >= cutoff}
        try:
            yield state
        finally:
            # Bound history even when the user never opens an alerted message.
            recent = sorted(state, key=lambda key: state[key]["created"], reverse=True)[:1000]
            with tempfile.NamedTemporaryFile(mode="w", dir=directory, delete=False) as stream:
                temporary = Path(stream.name)
                try:
                    json.dump({key: state[key] for key in recent}, stream)
                    stream.write("\n")
                    stream.close()
                    temporary.replace(filename)
                finally:
                    temporary.unlink(missing_ok=True)


def dismiss(token, state):
    """Remove only alerts fully acknowledged by opening their messages."""
    app = Path.home() / "Applications/Night Mail.app"
    for identifier, entry in list(state.items()):
        if token not in entry["messages"]:
            continue
        remaining = [value for value in entry["messages"] if value != token]
        if remaining:
            entry["messages"] = remaining
        else:
            # LaunchServices supplies the Aqua session even for detached GUI
            # Emacs. -g preserves focus; -n gives each removal its own process.
            run(["/usr/bin/open", "-g", "-n", "-W", "-a", app,
                 "--args", "-remove", identifier], timeout=12)
            del state[identifier]


def message_objects(tree):
    if isinstance(tree, list):
        for child in tree:
            yield from message_objects(child)
    elif isinstance(tree, dict) and tree.get("match") and "headers" in tree:
        yield tree


def candidates():
    root = Path(run(["notmuch", "config", "get", "database.mail_root"]).strip())
    accounts = sorted(child.name for child in root.iterdir() if (child / "INBOX").is_dir())
    if not accounts:
        return []
    # Quote Xapian literals, not shell strings. Never query bodies or entire threads.
    folders = " or ".join('folder:"' + (a + '/INBOX').replace('"', '""') + '"' for a in accounts)
    query = (f"tag:new and tag:inbox and tag:unread and ({folders}) "
             "and not tag:spam and not tag:deleted and not tag:draft")
    tree = json.loads(run(["notmuch", "show", "--format=json", "--body=false",
                           "--entire-thread=false", "--exclude=true", "--", query]))
    unique = {}
    for message in message_objects(tree):
        headers = message["headers"]
        unique[message["id"]] = {"id": message["id"], "from": decode(headers.get("From", "")),
                                  "subject": decode(headers.get("Subject", "")),
                                  "filenames": message.get("filename", []),
                                  "timestamp": message.get("timestamp", 0)}
    return sorted(unique.values(), key=lambda message: message["timestamp"], reverse=True)


def notifications(messages, groups):
    batches = defaultdict(list)
    for message in messages:
        for index, group in enumerate(groups):
            if all(pattern.search(message[field]) for field, pattern in group["match"].items()):
                if group["enabled"]:
                    batches[index].append(message)
                break
    for index, batch in batches.items():
        group = groups[index]
        limit = group["max_individual"]
        if group["show_details"] and len(batch) <= limit:
            for message in batch:
                yield (clean(message["subject"]) or "(No subject)",
                       clean(message["from"]) or "Unknown sender", body_preview(message, group), group,
                       [message_token(message["id"])])
        else:
            title = f"{len(batch)} new unread message" + ("s" if len(batch) != 1 else "")
            body = ""
            if group["show_details"]:
                previews = [(clean(m["subject"], 100) or "(No subject)") + "\n" + clean(m["from"], 60)
                            for m in batch[:limit]]
                body = "\n".join(previews)
            yield (title, clean(group["name"], 80), body, group, [message_token(m["id"]) for m in batch])


def deliver(items, state):
    helper = Path.home() / "Applications/Night Mail.app/Contents/MacOS/terminal-notifier"
    for title, subtitle, body, group, tokens in items:
        identifier = alert_id(tokens)
        # The leading backslash stops NSUserDefaults from parsing email text as a
        # plist; terminal-notifier removes exactly that first backslash.
        args = [str(helper), "-title", "\\" + title, "-subtitle", "\\" + subtitle,
                "-message", "\\" + body, "-group", identifier]
        if group["sound"]:
            args.extend(["-sound", "\\" + group["sound"]])
        if group["bypass_dnd"]:
            args.append("-ignoreDnD")
        try:
            run(args, timeout=12)
            state[identifier] = {"messages": sorted(set(tokens)), "created": time.time()}
        except (OSError, RuntimeError) as error:
            print(f"night-mail-notify: {error}", file=sys.stderr)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--init-config", action="store_true")
    parser.add_argument("--check", action="store_true")
    parser.add_argument("--initial-import", action="store_true")
    parser.add_argument("--dismiss", metavar="MESSAGE_HASH",
                        help="dismiss alerts acknowledged by this SHA-256 message ID")
    args = parser.parse_args()
    if args.dismiss and not re.fullmatch(r"[0-9a-f]{64}", args.dismiss):
        parser.error("--dismiss requires a SHA-256 message ID")
    filename = config_path()
    signal.signal(signal.SIGALRM, time_limit)
    signal.alarm(45)
    try:
        # Dismissal works even if the user has since disabled or broken policy.
        if args.dismiss:
            with alert_state() as state:
                dismiss(args.dismiss, state)
            return 0
        if args.init_config:
            filename.parent.mkdir(parents=True, exist_ok=True)
            try:
                fd = os.open(filename, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            except FileExistsError:
                pass
            else:
                with os.fdopen(fd, "w") as stream:
                    json.dump(DEFAULT_CONFIG, stream, indent=2)
                    stream.write("\n")
        groups = load_config(filename)
        if args.check or args.init_config:
            print(f"notification configuration valid: {filename}")
        elif not args.initial_import and any(group["enabled"] for group in groups):
            with alert_state() as state:
                deliver(notifications(candidates(), groups), state)
        return 0
    except (OSError, ValueError, RuntimeError, NotificationTimeout) as error:
        print(f"night-mail-notify: {filename}: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
