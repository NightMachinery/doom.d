# notmuch config.
# Generated by night-mail-render from email/templates/notmuch-config.tmpl in ~/doom.d.
# Edit the template, not this file; see docs/email.md there.

[database]
path=@NIGHT_MAIL_ROOT@
# pre-new moves files by tag and runs mbsync; post-new tags what arrived.
hook_dir=@NIGHT_MAIL_EMAIL_DIR@/notmuch-hooks

[user]
name=@NIGHT_MAIL_NAME@
primary_email=@NIGHT_MAIL_ADDRESS@
other_email=@NIGHT_MAIL_ALIASES@

[new]
# post-new turns `new' into the real tags, then removes it.
tags=new
ignore=.uidvalidity;.mbsyncstate;.mbsyncstate.new;.mbsyncstate.journal;.mbsyncstate.lock

[search]
exclude_tags=deleted;spam

[maildir]
# unread, flagged, replied, draft and passed round-trip to the server as
# IMAP flags. No other tag can: mbsync does not sync IMAP keywords.
synchronize_flags=true
