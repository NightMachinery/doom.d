# mbsync (isync 1.5) config for the @NIGHT_MAIL_ACCOUNT@ account.
# Generated by night-mail-render from email/templates/isyncrc.tmpl in ~/doom.d.
# Edit the template, not this file; see docs/email.md there.

IMAPAccount @NIGHT_MAIL_ACCOUNT@
Host @NIGHT_MAIL_HOST@
Port @NIGHT_MAIL_IMAP_PORT@
User @NIGHT_MAIL_USER@
# The password lives in the login Keychain, never in a file.
PassCmd "/usr/bin/security find-internet-password -s @NIGHT_MAIL_HOST@ -a @NIGHT_MAIL_USER@ -w"
TLSType IMAPS
# macOS's SASL library misbehaves with PLAIN; LOGIN is equally safe over TLS.
AuthMechs LOGIN
CertificateFile /opt/homebrew/etc/ca-certificates/cert.pem

# The server's personal NAMESPACE is "INBOX." and the default UseNamespace
# picks it up, so the far-side "Sent" is INBOX.Sent.
IMAPStore @NIGHT_MAIL_ACCOUNT@-remote
Account @NIGHT_MAIL_ACCOUNT@

MaildirStore @NIGHT_MAIL_ACCOUNT@-local
Path @NIGHT_MAIL_ROOT@/@NIGHT_MAIL_ACCOUNT@/
Inbox @NIGHT_MAIL_ROOT@/@NIGHT_MAIL_ACCOUNT@/INBOX
SubFolders Verbatim

Channel @NIGHT_MAIL_ACCOUNT@
Far :@NIGHT_MAIL_ACCOUNT@-remote:
Near :@NIGHT_MAIL_ACCOUNT@-local:
Patterns *
# A local folder (e.g. Archive, made by the pre-new mover) appears on the server.
Create Both
# Never delete a whole folder on either side because it vanished on the other.
Remove None
# The mover's moves only reach webmail if the stale copy is expunged.
Expunge Both
SyncState *
# Moved mail keeps its original date instead of jumping to the top.
CopyArrivalDate yes
