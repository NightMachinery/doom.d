# msmtp config for the @NIGHT_MAIL_ACCOUNT@ account.
# Generated by night-mail-render from email/templates/msmtp-config.tmpl in ~/doom.d.
# Edit the template, not this file; see docs/email.md there.

defaults
auth on
tls on
tls_trust_file system
logfile @NIGHT_MAIL_STATE_DIR@/msmtp.log

account @NIGHT_MAIL_ACCOUNT@
host @NIGHT_MAIL_HOST@
port @NIGHT_MAIL_SMTP_PORT@
# Port 465 speaks TLS from the first byte; there is no STARTTLS step.
tls_starttls off
user @NIGHT_MAIL_USER@
passwordeval "/usr/bin/security find-internet-password -s @NIGHT_MAIL_HOST@ -a @NIGHT_MAIL_USER@ -w"
from @NIGHT_MAIL_ADDRESS@

# Mail From an alias matches no account's `from', so it falls back to this
# one, which is the same mailbox.
account default : @NIGHT_MAIL_ACCOUNT@
