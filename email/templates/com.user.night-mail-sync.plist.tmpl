<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Generated by night-mail-render from email/templates/com.user.night-mail-sync.plist.tmpl in ~/doom.d.
     Installed by email/install-night-mail.zsh; see docs/email.md there. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.night-mail-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>@NIGHT_MAIL_EMAIL_DIR@/bin/night-mail-sync</string>
    </array>

    <!-- Every five minutes, and once at login. A tick that finds another
         sync running (say, one started from Emacs) skips itself. -->
    <key>StartInterval</key>
    <integer>300</integer>
    <key>RunAtLoad</key>
    <true/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>@NIGHT_MAIL_LOG_FILE@</string>
    <key>StandardErrorPath</key>
    <string>@NIGHT_MAIL_LOG_FILE@</string>

    <!-- A sync is network-bound and never urgent. -->
    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
