(ert-deftest mobile-clipboard-ssh-paste-toggle-and-routing-gates ()
  (let ((night/ssh-paste-enabled-p t)
        (kill-ring '("local"))
        (kill-ring-yank-pointer nil)
        mobile host calls)
    (setq kill-ring-yank-pointer kill-ring)
    (cl-letf (((symbol-function 'night/mobile-clipboard-frame-p) (lambda () mobile))
              ((symbol-function 'frame-parameter)
               (lambda (_frame parameter)
                 (and (eq parameter 'night/clipboard-ssh-host) host)))
              ((symbol-function 'night/h-mobile-clipboard-ssh-get)
               (lambda (&rest _) (push t calls) "remote")))
      (setq mobile t host "phone")
      (should (equal (current-kill 0) "remote"))
      (night/ssh-paste-toggle -1)
      (should-not night/ssh-paste-enabled-p)
      (should (equal (current-kill 0) "remote"))
      (should (= (length calls) 1))
      (night/ssh-paste-toggle 1)
      (setq mobile nil)
      (should (equal (current-kill 0) "remote"))
      (should (= (length calls) 1))
      (setq mobile t host "bad host")
      (should-error (current-kill 0) :type 'user-error)
      (setq host nil)
      (should (equal (current-kill 0) "remote")))))

(ert-deftest mobile-clipboard-explicit-paste-commands ()
  (let ((night/ssh-paste-enabled-p nil)
        host command calls)
    (cl-letf (((symbol-function 'frame-parameter)
               (lambda (_frame parameter)
                 (cond ((eq parameter 'night/clipboard-ssh-host) host)
                       ((eq parameter 'night/clipboard-ssh-paste-command) command))))
              ((symbol-function 'night/h-mobile-clipboard-ssh-get)
               (lambda (&rest args) (push args calls) "text")))
      (with-temp-buffer
        (setq host "phone")
        (night/ssh-paste)
        (should (equal (buffer-string) "text"))
        (should (equal (car calls) '("phone" nil)))
        (erase-buffer)
        (setq command "custom trusted getter")
        (night/ssh-paste)
        (should (equal (car calls) '("phone" "custom trusted getter")))
        (erase-buffer)
        (night/tealy-paste)
        (should (equal (buffer-string) "text"))
        (should (equal (car calls) '("tealy" "termux-clipboard-get")))
        (setq host nil)
        (should-error (night/ssh-paste) :type 'user-error)))))

(ert-run-tests-batch-and-exit)
