(ert-deftest mobile-clipboard-ssh-get-failure-timeout-and-cleanup ()
  (let ((real-make-process (symbol-function 'make-process))
        (night/mobile-clipboard-ssh-timeout 0.03)
        seen-buffers process)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq seen-buffers
                       (list (plist-get args :buffer) (plist-get args :stderr)))
                 (setq process
                       (apply real-make-process
                              (plist-put args :command '("/bin/sleep" "2")))))))
      (should-error (night/h-mobile-clipboard-ssh-get "phone") :type 'user-error)
      (should-not (process-live-p process))
      (should-not (cl-some #'buffer-live-p seen-buffers)))
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq seen-buffers
                       (list (plist-get args :buffer) (plist-get args :stderr)))
                 (apply real-make-process
                        (plist-put args :command '("/usr/bin/false"))))))
      (should-error (night/h-mobile-clipboard-ssh-get "phone") :type 'user-error)
      (should-not (cl-some #'buffer-live-p seen-buffers)))))

(ert-deftest mobile-clipboard-current-kill-routing-repeat-rotation-and-empty ()
  (let ((kill-ring '("old" "older"))
        (kill-ring-yank-pointer nil)
        (values '("remote" "remote" "remote" ""))
        (mobile t)
        calls)
    (setq kill-ring-yank-pointer kill-ring)
    (cl-letf (((symbol-function 'night/mobile-clipboard-frame-p) (lambda () mobile))
              ((symbol-function 'frame-parameter)
               (lambda (_frame parameter)
                 (and (eq parameter 'night/clipboard-ssh-host) "phone")))
              ((symbol-function 'night/h-mobile-clipboard-ssh-get)
               (lambda (host &optional _command) (push host calls) (pop values))))
      (should (equal (current-kill 0) "remote"))
      (should (equal (current-kill 0) "remote"))
      (should (= (cl-count "remote" kill-ring :test #'equal) 1))
      (should (equal (current-kill 1) "old"))
      ;; Rotation does not fetch; a subsequent normal paste freshly reads and
      ;; resets the yank pointer even when the clipboard text is unchanged.
      (should (= (length calls) 2))
      (should (equal (current-kill 0) "remote"))
      (should (equal (car kill-ring-yank-pointer) "remote"))
      ;; A genuinely empty clipboard must not return the previous kill.
      (should (equal (current-kill 0) ""))
      (should (equal (car kill-ring) ""))
      (setq mobile nil)
      (should (equal (current-kill 0) ""))
      (should (= (length calls) 4)))))

(ert-deftest mobile-clipboard-current-kill-import-bypasses-copy-policy ()
  (let ((kill-ring '("stale"))
        (kill-ring-yank-pointer nil)
        cut-events)
    (setq kill-ring-yank-pointer kill-ring)
    (cl-letf (((symbol-function 'night/mobile-clipboard-frame-p) (lambda () t))
              ((symbol-function 'frame-parameter)
               (lambda (_frame parameter)
                 (and (eq parameter 'night/clipboard-ssh-host) "phone")))
              ((symbol-function 'night/h-mobile-clipboard-ssh-get)
               (lambda (_host &optional _command) " \n\n"))
              ((symbol-function 'night/mobile-clipboard-cut)
               (lambda (text) (push text cut-events))))
      (unwind-protect
          (progn
            (advice-add 'kill-new :around #'night/h-kill-skip-whitespace)
            (should (equal (current-kill 0) " \n\n"))
            (should (equal (car kill-ring) " \n\n"))
            (should-not cut-events))
        (advice-remove 'kill-new #'night/h-kill-skip-whitespace)))))

(ert-deftest mobile-clipboard-ssh-get-waits-for-queued-copy ()
  (let ((night/h-mobile-clipboard-ssh-jobs (make-hash-table :test #'equal))
        (real-make-process (symbol-function 'make-process))
        (real-accept-process-output (symbol-function 'accept-process-output))
        waited)
    (puthash "phone" (list :busy t :pending nil)
             night/h-mobile-clipboard-ssh-jobs)
    (cl-letf (((symbol-function 'accept-process-output)
              (lambda (&rest _)
                 (cond
                  ((not waited)
                   (setq waited t)
                   (setf (plist-get
                          (gethash "phone" night/h-mobile-clipboard-ssh-jobs)
                          :busy) nil))
                  (t (funcall real-accept-process-output nil 0.01)))))
              ((symbol-function 'make-process)
               (lambda (&rest args)
                 (apply real-make-process
                        (plist-put args :command
                                   '("/bin/sh" "-c" "printf ready"))))))
      (should (equal (night/h-mobile-clipboard-ssh-get "phone") "ready"))
      (should waited))))

(ert-deftest mobile-clipboard-ssh-get-quit-cleans-process-and-buffers ()
  (let ((real-make-process (symbol-function 'make-process))
        seen-buffers process)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args)
                 (setq seen-buffers
                       (list (plist-get args :buffer) (plist-get args :stderr)))
                 (setq process
                       (apply real-make-process
                              (plist-put args :command '("/bin/sleep" "2"))))))
              ((symbol-function 'accept-process-output)
               (lambda (&rest _) (signal 'quit nil))))
      (should (condition-case nil
                  (progn (night/h-mobile-clipboard-ssh-get "phone") nil)
                (quit t)))
      (should-not (process-live-p process))
      (should-not (cl-some #'buffer-live-p seen-buffers)))))

(ert-deftest mobile-clipboard-evil-paste-pop-inhibits-fresh-read ()
  (let ((kill-ring '("new" "old"))
        (kill-ring-yank-pointer nil)
        calls)
    (setq kill-ring-yank-pointer kill-ring)
    (cl-letf (((symbol-function 'night/mobile-clipboard-frame-p) (lambda () t))
              ((symbol-function 'frame-parameter)
               (lambda (_frame parameter)
                 (and (eq parameter 'night/clipboard-ssh-host) "phone")))
              ((symbol-function 'night/h-mobile-clipboard-ssh-get)
               (lambda (_host &optional _command) (push t calls) "remote")))
      (should
       (equal (night/h-mobile-clipboard-evil-paste-pop
               (lambda ()
                 ;; Evil first rotates, then its paste implementation asks for
                 ;; index zero from a temporary one-element kill ring.
                 (let* ((rotated (current-kill 1))
                        (kill-ring (list rotated))
                        (kill-ring-yank-pointer kill-ring))
                   (current-kill 0))))
              "old"))
      (should-not calls))))

