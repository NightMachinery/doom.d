;;; -*- lexical-binding: t; -*-
(setq native-comp-enable-subr-trampolines nil)
(require 'ert)
(require 'cl-lib)
(require 'org)
(require 'org-element)
(defmacro after! (&rest _) nil)
(defun night/set-leader-keys (&rest _) nil)
(defconst night-test/email-dir (expand-file-name "../email" (file-name-directory load-file-name)))
(load (expand-file-name "../autoload/night-email.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest night-mail-thread-order-is-flat-stable-and-newest-first ()
  (let* ((old '(:id "old" :timestamp 1))
         (new '(:id "new" :timestamp 3))
         (sibling '(:id "sibling" :timestamp 2))
         (forest (list (list (list old (list (list new nil) (list sibling nil))))))
         (before (copy-tree forest))
         (night/notmuch-thread-order 'newest-first)
         (result (car (night/h-notmuch-order-forest (list forest)))))
    (should (equal (mapcar (lambda (tree) (plist-get (car tree) :id)) (car result))
                   '("new" "sibling" "old")))
    (should (cl-every (lambda (tree) (null (cadr tree))) (car result)))
    (should (equal forest before))
    (let ((night/notmuch-thread-order 'threaded))
      (should (eq (car (night/h-notmuch-order-forest (list forest))) forest)))))

(ert-deftest night-mail-history-is-collapsed-portable-and-reversible ()
  (let* ((night/mail-collapse-history t)
         (rendered (night/h-org-fontify-for-display
                    "New reply\n\n#+begin_quote\nOld reply [[https://example.org][link]]\n> Older\n#+end_quote\n\nAfter\n")))
    (with-temp-buffer
      (insert rendered)
      (night/h-notmuch-apply-link-display)
      (goto-char (point-min))
      (search-forward "Quoted history")
      (let ((button (button-at (1- (point)))))
        (should button)
        (search-forward "Old reply")
        (let ((text-position (1- (point))))
          (should (invisible-p text-position))
          (button-activate button)
          (should-not (invisible-p text-position))
          (button-activate button)
          (should (invisible-p text-position))))
      (should-not (string-match-p "#\\+\\(?:begin\\|end\\)_quote" (buffer-string)))
      (should (string-match-p "After" (buffer-string))))))

(ert-deftest night-mail-history-does-not-hide-the-following-message ()
  (with-temp-buffer
    (insert (night/h-org-fontify-for-display "#+begin_quote\nOld reply\n#+end_quote\n"))
    (night/h-notmuch-apply-link-display)
    (goto-char (point-max))
    (insert "Next message")
    (should-not (invisible-p (1- (point))))
    (should-not (get-text-property (1- (point)) 'night-mail-history-id))))

(ert-deftest night-mail-pandoc-flattens-nested-history-with-links-intact ()
  (skip-unless (executable-find "pandoc"))
  (let ((night/mail-email-dir night-test/email-dir))
    (let ((org (night/h-html-to-org "<p>New</p><blockquote><p>Old</p><blockquote><a href='https://example.org'>Older</a></blockquote></blockquote>")))
      (should org)
      (should (= (with-temp-buffer (insert org) (count-matches "#\\+begin_quote" (point-min) (point-max))) 1))
      (should (string-match-p "> .*https://example.org" org)))))

(ert-run-tests-batch-and-exit)
