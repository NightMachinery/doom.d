;;; -*- lexical-binding: t; -*-
(setq native-comp-enable-subr-trampolines nil)
(require 'ert)
(require 'cl-lib)
(defmacro after! (&rest _) nil)
(defun night/set-leader-keys (&rest _) nil)
(load (expand-file-name "../autoload/night-email.el"
                        (file-name-directory (or load-file-name buffer-file-name))) nil t)

(ert-deftest night-mail-sync-uses-login-worker-on-macos ()
  (let ((system-type 'darwin)
        (night/h-mail-sync-process nil)
        (night/mail-email-dir "/example/email")
        (night/mail-sync-wait 42)
        captured)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args) (setq captured args) 'fixture)))
      (night/mail-sync)
      (should (equal (plist-get captured :command)
                     '("/bin/bash" "/example/email/bin/night-mail-sync" "--request" "--wait" "42")))
      (should (eq (plist-get captured :connection-type) 'pipe)))))

(ert-deftest night-mail-sync-keeps-direct-worker-on-other-platforms ()
  (let ((system-type 'gnu/linux)
        (night/h-mail-sync-process nil)
        (night/mail-email-dir "/example/email")
        captured)
    (cl-letf (((symbol-function 'make-process)
               (lambda (&rest args) (setq captured args) 'fixture)))
      (night/mail-sync)
      (should-not (member "--request" (plist-get captured :command))))))

(ert-deftest night-mail-sync-reports-fetch-failure-after-indexing ()
  (let ((buffer (generate-new-buffer " sync-fixture")))
    (unwind-protect
        (dolist (status '(0 69 1))
          (let ((refreshes 0) report)
            (cl-letf (((symbol-function 'process-status) (lambda (_) 'exit))
                      ((symbol-function 'process-exit-status) (lambda (_) status))
                      ((symbol-function 'process-buffer) (lambda (_) buffer))
                      ((symbol-function 'notmuch-refresh-all-buffers)
                       (lambda () (cl-incf refreshes)))
                      ((symbol-function 'message)
                       (lambda (fmt &rest args) (setq report (apply #'format fmt args)))))
              (night/h-mail-sync-sentinel 'fixture "finished")
              (should (= refreshes (cond ((memq status '(0 69)) 1) (t 0))))
              (cond ((= status 69) (should (string-match-p "fetch FAILED" report)))
                    ((= status 0) (should (equal report "night/mail-sync: done")))
                    (t (should (string-match-p "failed with status 1" report)))))))
      (kill-buffer buffer))))

(ert-deftest night-mail-open-dismisses-only-expanded-current-message ()
  (let ((system-type 'darwin)
        (major-mode 'notmuch-show-mode)
        (night/mail-email-dir "/example/email")
        (night/mail-dismiss-notifications-on-open t)
        dismissed captured)
    (cl-letf (((symbol-function 'notmuch-show-message-visible-p) (lambda () t))
              ((symbol-function 'notmuch-show-get-prop) (lambda (_) dismissed))
              ((symbol-function 'notmuch-show-set-prop) (lambda (_ value) (setq dismissed value)))
              ((symbol-function 'notmuch-show-get-message-id)
               (lambda (bare) (should bare) "fixture@example.org"))
              ((symbol-function 'make-process) (lambda (&rest args) (push args captured))))
      (night/h-mail-dismiss-open-notification)
      (night/h-mail-dismiss-open-notification)
      (should (= (length captured) 1))
      (should (equal (cdr (plist-get (car captured) :command))
                     (list "/example/email/bin/night-mail-notify" "--dismiss"
                           (secure-hash 'sha256 "fixture@example.org"))))
      (should (eq (plist-get (car captured) :connection-type) 'pipe)))))

(ert-deftest night-mail-dismiss-skips-collapsed-disabled-and-other-buffers ()
  (let ((system-type 'darwin)
        (major-mode 'notmuch-show-mode)
        (night/mail-dismiss-notifications-on-open t)
        (visible nil))
    (cl-letf (((symbol-function 'notmuch-show-message-visible-p) (lambda () visible))
              ((symbol-function 'notmuch-show-get-prop) (lambda (_) nil))
              ((symbol-function 'make-process) (lambda (&rest _) (ert-fail "unexpected dismissal"))))
      (night/h-mail-dismiss-open-notification)
      (setq visible t night/mail-dismiss-notifications-on-open nil)
      (night/h-mail-dismiss-open-notification)
      (setq night/mail-dismiss-notifications-on-open t major-mode 'notmuch-search-mode)
      (night/h-mail-dismiss-open-notification)
      (setq major-mode 'notmuch-show-mode system-type 'gnu/linux)
      (night/h-mail-dismiss-open-notification))))

(ert-deftest night-mail-dismiss-start-failure-does-not-break-reading ()
  (let ((system-type 'darwin)
        (major-mode 'notmuch-show-mode)
        (night/mail-dismiss-notifications-on-open t))
    (cl-letf (((symbol-function 'notmuch-show-message-visible-p) (lambda () t))
              ((symbol-function 'notmuch-show-get-prop) (lambda (_) nil))
              ((symbol-function 'notmuch-show-get-message-id) (lambda (_) "fixture"))
              ((symbol-function 'make-process) (lambda (&rest _) (error "fixture"))))
      (should-not (night/h-mail-dismiss-open-notification)))))

(ert-run-tests-batch-and-exit)
